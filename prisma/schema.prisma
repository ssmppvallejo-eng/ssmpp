generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Descriptor {
  id                             Int                             @id @default(autoincrement())
  title                          String
  value                          Int
  description                    String
  indicatorId                    Int
  assignmentIndicatorDescriptors AssignmentIndicatorDescriptor[]
  indicator                      Indicator                       @relation(fields: [indicatorId], references: [id])
}

model Assignment {
  id             Int                   @id @default(autoincrement())
  ownerId        Int
  assignmentDate DateTime?
  submissionDate DateTime?
  status         IndicatorStatus       @default(PENDIENTE)
  dimensionId    Int
  dimension      Dimension             @relation(fields: [dimensionId], references: [id])
  owner          User                  @relation(fields: [ownerId], references: [id])
  indicators     AssignmentIndicator[]
  assignedUsers  UserAssignTo[]
}

model AssignmentIndicator {
  id                    Int                             @id @default(autoincrement())
  indicatorId           Int
  assignmentId          Int
  assignment            Assignment                      @relation(fields: [assignmentId], references: [id])
  indicator             Indicator                       @relation(fields: [indicatorId], references: [id])
  descriptorAssignments AssignmentIndicatorDescriptor[]
}

model AssignmentIndicatorDescriptor {
  assignmentIndicatorId Int
  descriptorId          Int
  valueAssigned         Int
  evaluationValue       Int?
  note                  String?
  evidenceName          String?
  evidenceUrl           String?
  addComment            Boolean             @default(false)
  addEvidence           Boolean             @default(false)
  complete              Boolean             @default(false)
  id                    Int                 @id @default(autoincrement())
  comment               String?
  assignmentIndicator   AssignmentIndicator @relation(fields: [assignmentIndicatorId], references: [id])
  descriptor            Descriptor          @relation(fields: [descriptorId], references: [id])

  @@unique([assignmentIndicatorId, descriptorId])
}

model Component {
  title       String
  description String?
  code        String      @unique
  id          Int         @id @default(autoincrement())
  dimensionId Int
  dimension   Dimension   @relation(fields: [dimensionId], references: [id])
  judgements  Judgement[]
}

model Indicator {
  description   String
  code          String                @unique
  justification String?
  id            Int                   @id @default(autoincrement())
  judgementId   Int
  assignments AssignmentIndicator[]
  descriptors Descriptor[]
  judgement   Judgement             @relation(fields: [judgementId], references: [id])
  templates   TemplateIndicator[]
}

model Judgement {
  title       String
  description String?
  code        String      @unique
  componentId Int
  id          Int         @id @default(autoincrement())
  indicators  Indicator[]
  component   Component   @relation(fields: [componentId], references: [id])
}

model Postgraduate {
  id            Int                @id @default(autoincrement())
  level         Level
  knowledgeArea Area
  title         String
  templates     Template[]
  users         UserPostgraduate[]
}

model Dimension {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  title       String
  description String?
  assignments Assignment[]
  components  Component[]
}

model Template {
  description    String?
  id             Int                 @id @default(autoincrement())
  name           String
  postgraduateId Int
  postgraduate   Postgraduate        @relation(fields: [postgraduateId], references: [id])
  indicators     TemplateIndicator[]
}

model TemplateIndicator {
  indicatorId Int
  templateId  Int
  indicator   Indicator @relation(fields: [indicatorId], references: [id])
  template    Template  @relation(fields: [templateId], references: [id])

  @@id([templateId, indicatorId])
}

model User {
  email         String             @unique
  role          Role               @default(ESTUDIANTE)
  accessStatus  AccessStatus       @default(PENDIENTE)
  id            Int                @id @default(autoincrement())
  image         String?
  name          String?
  assignments   Assignment[]
  assignedTo    UserAssignTo[]
  postgraduates UserPostgraduate[]
}

model UserAssignTo {
  assignmentId Int
  userId       Int
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  user         User       @relation(fields: [userId], references: [id])

  @@id([assignmentId, userId])
}

model EvidenceFile {
  id        Int      @id @default(autoincrement())
  filename  String
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}

model UserPostgraduate {
  userId         Int
  postgraduateId Int
  postgraduate   Postgraduate @relation(fields: [postgraduateId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@id([userId, postgraduateId])
}

enum Area {
  CIENCIAS_EXACTAS
  CIENCIAS_NATURALES_Y_AGROPECUARIAS
  CIENCIAS_DE_LA_SALUD
  CIENCIAS_DE_LA_EDUCACION_Y_HUMANIDADES
  CIENCIAS_SOCIALES_Y_ADMINISTRATIVAS
  INGENIERIA_Y_TECNOLOGIAS
}

enum IndicatorStatus {
  PENDIENTE
  EN_PROCESO
  ENVIADO
  EN_REVISION
  COMPLETADO
  NO_COMPLETADO
}

enum Level {
  ESPECIALIDADES
  MAESTRIAS
  DOCTORADOS
  ESPECIALIDADES_MEDICAS
}

enum AccessStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum Role {
  ADMINISTRADOR
  ESTUDIANTE
  COORDINADOR
  PROFESOR
  EVALUADOR
}

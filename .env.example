# PostgreSQL de este ambiente. En serverless usa la URL con connection pooling.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Google Cloud Console > APIs y servicios > Credenciales > OAuth 2.0.
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# URL publica exacta, sin slash final.
NEXTAUTH_URL="http://localhost:3000"

# Genera un valor distinto por ambiente con: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
